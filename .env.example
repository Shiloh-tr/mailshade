# Gmail SMTP defaults. Copy this file to .env and replace the placeholders.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-test-sender@gmail.com
SMTP_PASS=your-16-character-app-password

# The Gmail inbox opened on the mirrored iPhone.
SMTP_FROM=your-test-sender@gmail.com
TEST_EMAIL_TO=your-test-inbox@gmail.com
