{
  "name": "mailshade-email-dark-mode-simulator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs tests/*.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "smtp:verify": "node scripts/verify-smtp.mjs",
    "fixtures:list": "node scripts/send-fixtures.mjs --list",
    "fixtures:send": "node scripts/send-fixtures.mjs --all",
    "fixtures:send:selected": "node scripts/send-fixtures.mjs",
    "preview": "node --experimental-strip-types scripts/preview-email.mjs",
    "captures:analyze": "node scripts/analyze-captures.mjs",
    "captures:align": "node scripts/align-captures.mjs",
    "captures:fit": "node scripts/fit-profile.mjs",
    "captures:validate": "node scripts/validate-profile.mjs",
    "captures:visual": "node scripts/validate-visual.mjs",
    "captures:geometry": "node scripts/validate-geometry.mjs",
    "compatibility:sync": "node scripts/sync-compatibility-catalog.mjs",
    "compatibility:query": "node scripts/query-compatibility.mjs",
    "compatibility:audit": "node scripts/audit-compatibility.mjs",
    "skills:validate": "node scripts/validate-skills.mjs",
    "verification:audit": "node scripts/audit-verification.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "linkedom": "^0.18.13",
    "nodemailer": "^9.0.5",
    "postcss": "^8.5.26",
    "postcss-selector-parser": "^7.1.5",
    "postcss-value-parser": "^4.2.0",
    "puppeteer-core": "^25.7.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.34.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "yaml": "^2.9.0"
  },
  "type": "module"
}
